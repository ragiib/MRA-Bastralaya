# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug & logs
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets should never be committed)
.env
.env*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# SQLite Database Files (local data and credentials must never be committed)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
*.sqlite
*.sqlite3
!/data/.gitkeep

# vercel
.vercel

# typescript & caches
*.tsbuildinfo
next-env.d.ts
.turbo/

# ide & editor
.idea/
.vscode/
*.swp
*.swo

# local uploads
/public/uploads/products/*
!/public/uploads/products/.gitkeep

