# MRA Bastralaya - Environment Variables Template
# Copy this file to .env.local and populate with your own secret keys

# Authentication Secret (Used for signing HttpOnly JWT session tokens)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secret_64_character_hex_key_here

# Initial Admin Provisioning (Server-Side Only - Used for initial setup)
INITIAL_ADMIN_EMAIL=admin@mrabastralaya.com
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere123!
INITIAL_ADMIN_NAME=MRA Store Administrator

# WhatsApp Store Desk (International format without leading + or special characters)
NEXT_PUBLIC_OWNER_WHATSAPP_NUMBER=919830000000

