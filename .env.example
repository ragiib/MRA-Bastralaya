# MRA Bastralaya - Environment Variables Template
# Copy this file to .env.local and populate with your own secret keys

# Authentication Secret (Used for signing HttpOnly JWT session tokens)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secret_64_character_hex_key_here

# Initial Admin Provisioning (Server-Side Only - Used for initial setup)
INITIAL_ADMIN_EMAIL=mrabastrlaya@gmail.com
INITIAL_ADMIN_PASSWORD=SetAStrongPasswordHere123!
INITIAL_ADMIN_NAME=MRA Store Administrator

# WhatsApp Store Desk (International format without leading + or special characters)
NEXT_PUBLIC_OWNER_WHATSAPP_NUMBER=919830000000

# Gmail SMTP Email Delivery for Admin 2FA (Two-Factor Authentication)
# Requires 2-Step Verification enabled on the sender Google Account:
# 1. Sign in to your Google Account (e.g. your Gmail address for the store).
# 2. Go to Google Account Security: https://myaccount.google.com/security
# 3. Enable "2-Step Verification" if it is not already active.
# 4. Search for "App passwords" in your Google Account settings.
# 5. Create a new App Password (e.g., named "MRA Bastralaya Admin").
# 6. Google will generate a 16-character password (e.g., "abcd efgh ijkl mnop").
# IMPORTANT: Put that 16-character App Password below. Do NOT use your regular Gmail password!
EMAIL_USER=your-store-email@gmail.com
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# Neon Postgres Database Connections
# DATABASE_URL: Direct unpooled connection (used for schema migrations and administrative scripts)
DATABASE_URL="postgresql://user:password@ep-xyz.c-3.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_POOLED: Connection pooled via PgBouncer (used for high-concurrency serverless runtime queries)
DATABASE_URL_POOLED="postgresql://user:password@ep-xyz-pooler.c-3.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Image Storage (For product catalog images on Vercel)
# 1. Sign up for a free account at https://cloudinary.com
# 2. Open the Cloudinary Dashboard (https://console.cloudinary.com/pm)
# 3. Copy your Cloud Name, API Key, and API Secret from Dashboard > Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

